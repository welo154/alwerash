# =============================================================================
# Database (Supabase)
# =============================================================================
# Copy values from Supabase → Project Settings → Database → Connection string.
#
# IPv4 networks: use the "Session pooler" string (host like aws-0-REGION.pooler.supabase.com,
# port 5432, user postgres.PROJECT_REF). Do not use the "Transaction pooler" :6543 URL unless
# you know you need it; it often fails from home/office IPv4 setups.
#
# "Direct connection" (db.PROJECT_REF.supabase.co:5432, user postgres) may be labeled
# "Not IPv4 compatible" — use for DIRECT_URL only if migrations work from your network,
# or run migrations from Supabase SQL / a host with IPv6 / enable Supabase IPv4 add-on.
#
# URL-encode special characters in the password (e.g. $ → %24).
#
# Runtime (Prisma queries) — Session pooler example:
# Honour the port in this URL. The app no longer rewrites pooler hosts onto :6543.
# Session pooler (:5432) is the default; transaction pooler (:6543) is opt-in if
# you need more concurrent serverless instances (and pays pgbouncer overhead).
# Do NOT raise connection_limit above ~5 on port 5432 — Supabase session pool_size is 15 total.
# Do not wrap the URI in quotes.
DATABASE_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require&connection_limit=10&pool_timeout=30"
#
# Migrations (Prisma migrate) — Prefer session pooler (same as DATABASE_URL) if db.*.supabase.co
# returns P1001 / "Can't reach database" on your network (common on IPv4-only).
# Direct host example (only if it works from your machine):
# DIRECT_URL="postgresql://postgres:YOUR_PASSWORD@db.PROJECT_REF.supabase.co:5432/postgres?sslmode=require"
DIRECT_URL="postgresql://postgres.PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres?sslmode=require"
#
# Replace PROJECT_REF, REGION, and YOUR_PASSWORD with your Supabase values.

# =============================================================================
# Auth.js / NextAuth
# =============================================================================
# Generate with: openssl rand -base64 32  (or: node -e "console.log(require('crypto').randomBytes(32).toString('base64'))")
AUTH_SECRET="replace-with-generated-secret"

# Set to "true" in development; required for auth callbacks to work
AUTH_TRUST_HOST="true"

# App URL — must match the origin you open in the browser (default `npm run dev` uses port 3002)
AUTH_URL="http://localhost:3002"

# Legacy names (Auth.js v4 / NextAuth); optional if you use AUTH_* above
# NEXTAUTH_SECRET="same-as-AUTH_SECRET"
# NEXTAUTH_URL="http://localhost:3002"

# OAuth providers (redirect: {AUTH_URL}/api/auth/callback/{provider})
GOOGLE_CLIENT_ID="replace-with-google-client-id"
GOOGLE_CLIENT_SECRET="replace-with-google-client-secret"
# FACEBOOK_CLIENT_ID="replace-with-facebook-app-id"
# FACEBOOK_CLIENT_SECRET="replace-with-facebook-app-secret"
# APPLE_ID="replace-with-apple-services-id"
# APPLE_TEAM_ID="replace-with-apple-team-id"
# APPLE_KEY_ID="replace-with-apple-key-id"
# APPLE_PRIVATE_KEY="-----BEGIN PRIVATE KEY-----\n...\n-----END PRIVATE KEY-----"

# =============================================================================
# Admin seed (for: npx prisma db seed)
# =============================================================================
ADMIN_EMAIL="admin@example.com"
ADMIN_PASSWORD="replace-with-secure-password"
ADMIN_NAME="Platform Admin"

# =============================================================================
# Mux API (video upload & HLS playback)
# =============================================================================
# From Mux dashboard: Settings → Access Tokens
MUX_TOKEN_ID="replace-with-mux-token-id"
MUX_TOKEN_SECRET="replace-with-mux-token-secret"

# Mux webhook signing secret (from webhook config in Mux dashboard)
MUX_WEBHOOK_SECRET="replace-with-webhook-secret"

# Mux signing keypair (required for lesson playback)
MUX_SIGNING_KEY_ID="replace-with-signing-key-id"
# PEM: one line with \n for newlines
MUX_PRIVATE_KEY="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Signed playback token TTL. Prefer seconds (Mux JWT expiration).
MUX_SIGNED_PLAYBACK_TTL_SECONDS="3600"
# Fallback duration string if seconds are unset (e.g. 1h)
MUX_PLAYBACK_TOKEN_TTL="1h"

# CORS origin for direct upload (match your dev server origin, e.g. localhost:3002)
MUX_UPLOAD_CORS_ORIGIN="http://localhost:3002"

# =============================================================================
# Email (Resend) — verification + capstone assignment notifications
# =============================================================================
# From https://resend.com/api-keys
RESEND_API_KEY="replace-with-resend-api-key"
# Sender for verification and assignment emails.
# Local/testing: use Resend's test address (usually only delivers to your Resend account email).
# Production: verify your domain in Resend, then use an address on that domain.
RESEND_FROM_EMAIL="Alwerash <onboarding@resend.dev>"
# Deep links in emails use AUTH_URL / NEXTAUTH_URL (see Auth section above).

# =============================================================================
# Microsoft Clarity (session replay + heatmaps)
# =============================================================================
# From https://clarity.microsoft.com → your project → Settings → Overview → Project ID
NEXT_PUBLIC_CLARITY_PROJECT_ID="y32zdmd8vu"
# Clarity is off in local `next dev` by default (avoids polluting production data).
# Set to "true" only when you need to verify the snippet locally.
# NEXT_PUBLIC_CLARITY_IN_DEV="true"

# =============================================================================
# Performance measurement (see docs/performance/00-measurement.md)
# =============================================================================
# Per-request database timing on stdout. Unset or "0" disables it entirely.
#   "1"       one summary line per request
#   "verbose" adds a line per query
# The summary reports `concurrency`: db-sum / db-wall. A value near 1.00 means
# queries ran one at a time, so any Promise.all in the page did nothing.
# PERF_TIMING="1"

# Override Prisma's client-side pool size (1–20). Defaults to 5 in development
# and 1 in production. Set this to 1 locally to reproduce production behaviour.
# The Supabase session pooler (:5432) shares a total pool_size of 15, so check
# the pooler mode before raising it.
# DB_CONNECTION_LIMIT="1"

# List unpublished tracks/courses in the public catalog. Production should leave
# this unset (published-only). Set locally only when the database has no published rows.
# CATALOG_SHOW_UNPUBLISHED="true"
