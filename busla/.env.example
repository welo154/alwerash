# ── Supabase ──────────────────────────────────────────────
# Project Settings → API. The service role key stays on the server only
# (it is used inside API routes, never sent to the browser).
SUPABASE_URL=https://YOUR-PROJECT.supabase.co
SUPABASE_SERVICE_ROLE_KEY=

# ── Compass, the AI mentor ────────────────────────────────
# Without a key the mentor still works using the built-in rule-based guide.
ANTHROPIC_API_KEY=
# Optional override; defaults to claude-opus-5-5
BUSLA_MENTOR_MODEL=
# Store mentor conversations in Supabase (true/false). Off by default because
# many users are minors — turn it on only if your privacy notice covers it.
BUSLA_LOG_CHATS=false

# ── Event ─────────────────────────────────────────────────
# ISO date with Cairo offset. Drives the countdown.
NEXT_PUBLIC_EVENT_DATE=2027-02-13T10:00:00+02:00
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Organizer dashboard (/admin) ──────────────────────────
ADMIN_PASSWORD=
